FLASK_SECRET=replace_with_random_secret
# Gmail API settings. Required for email on Render's Free plan.
GMAIL_API_CLIENT_ID=your_oauth_client_id
GMAIL_API_CLIENT_SECRET=your_oauth_client_secret
GMAIL_API_REFRESH_TOKEN=your_gmail_refresh_token
EMAIL_FROM="AYLB Logistics <your_gmail_address@gmail.com>"
EMAIL_TO=receiving_email@example.com

# Optional SMTP fallback for hosts that allow outbound SMTP (not Render Free).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=your_gmail_address@gmail.com
# SMTP_PASSWORD=your_gmail_app_password
